{
  "name": "pit-stop",
  "version": "5.0.0",
  "description": "Plataforma digital de gestão automotiva — garagem, revisões e manutenções em um só lugar.",
  "main": "server.js",
  "keywords": [
    "automotivo",
    "gestão",
    "garagem",
    "nodejs",
    "express",
    "ejs",
    "sqlite"
  ],
  "author": "Gustavo Pereira De Sousa",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "puppeteer-core": "^24.43.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js",
      "<rootDir>/tests/integration/**/*.test.js"
    ],
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "regras.js",
      "db.js",
      "server.js",
      "routes/**/*.js"
    ],
    "coverageThreshold": {
      "./regras.js": {
        "lines": 100,
        "branches": 90,
        "functions": 100
      }
    },
    "forceExit": true
  }
}
